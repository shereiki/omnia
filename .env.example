# Copy to .env.local for local migration and preview. Never commit real values.
# Production values belong in the Vercel project, not in this file.

# Pooled Neon connection string injected by the Vercel Marketplace integration.
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# 12 or more characters. This is the password for /admin/login.
ADMIN_PASSWORD=replace-with-a-long-password

# 32 or more characters. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=replace-with-a-random-string-at-least-32-chars
